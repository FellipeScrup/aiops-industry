# Copie este arquivo para .env e ajuste os valores antes de subir a stack.
# cp .env.example .env

# ── PostgreSQL (Silver layer) ───────────────────────────────────────────────
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aiops_industry

# ── MinIO (Bronze layer) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# ── MLflow ──────────────────────────────────────────────────────────────────
# MLFLOW_BACKEND_URI aponta para o database "mlflow" criado automaticamente no postgres
MLFLOW_BACKEND_URI=postgresql://aiops:change_me@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow/
# Credenciais para o MLflow acessar o MinIO como artifact store
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# ── LLM / Ollama ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# ── Gemini (Google Generative AI) ───────────────────────────────────────────
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
